{
  "name": "@qiaomu/dsh-radio",
  "version": "0.1.1",
  "description": "乔木电台 · DSH 插件：在 DeepSeek Harness 里收听全球直播电台，五种播放器环境、场景频道、本地口味记忆。",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "向阳乔木 (https://x.com/vista8)",
  "homepage": "https://radio.qiaomu.ai/",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/dsh/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/player/**",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "docs/INSTALL.md",
    "LICENSE",
    "screenshots.json",
    "docs/screenshots/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": []
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "node scripts/build-preview.mjs && node preview-dist/server.mjs",
    "preview:serve": "node preview-dist/server.mjs",
    "check": "npm run typecheck && npm run test && npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "hls.js": "^1.6.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeseesun/qiaomu-radio-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/joeseesun/qiaomu-radio-dsh/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "radio",
    "music"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
