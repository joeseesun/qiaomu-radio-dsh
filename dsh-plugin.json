{
  "id": "@qiaomu/dsh-radio",
  "name": "乔木电台",
  "version": "0.1.1",
  "summary": "在 DeepSeek Harness 里发现和收听全球直播电台：五种播放器环境、场景频道、本地口味记忆。",
  "halves": {
    "host": {
      "entry": "lib/index.js",
      "inject": [
        "webServer"
      ],
      "role": "提供电台目录、播放地址解析、now playing 抓取、HLS 流代理，并注册播放器页面路由。"
    },
    "client": {
      "entry": "lib/client.js",
      "platform": "web",
      "state": "已实现：通过侧栏入口打开宿主提供的播放器页面。"
    }
  },
  "routes": [
    {
      "method": "GET",
      "path": "/qiaomu-radio/",
      "purpose": "独立播放器页面"
    },
    {
      "method": "GET",
      "path": "/qiaomu-radio/<file>",
      "purpose": "播放器脚本与样式"
    },
    {
      "method": "GET",
      "path": "/qiaomu-radio/stream/<encoded upstream>",
      "purpose": "HLS 播放列表与分片代理"
    },
    {
      "method": "GET|POST",
      "path": "/qiaomu-radio/api/radio/catalog",
      "purpose": "电台目录"
    },
    {
      "method": "GET|POST",
      "path": "/qiaomu-radio/api/radio/resolve-play",
      "purpose": "播放地址解析"
    },
    {
      "method": "GET|POST",
      "path": "/qiaomu-radio/api/radio/now-playing",
      "purpose": "正在播放曲目"
    }
  ],
  "privacy": {
    "network": [
      "Radio Browser 公共目录镜像（de1/nl1/at1.api.radio-browser.info）",
      "所选中电台的直播地址",
      "SomaFM 频道的公开曲目元数据（somafm.com）"
    ],
    "local": [
      "喜欢、跳过、音量、收听历史保存在浏览器本地存储与插件数据席位",
      "不读取、不上传工作区文件"
    ],
    "telemetry": "无客户端遥测。"
  }
}
